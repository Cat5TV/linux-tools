#!/bin/bash

# Requirements:
#
# imagemagick (Will auto-install on Debian/RHEL if missing)

targetsize=$1
file=$2
strip_args=""

# Optional 3rd argument to strip EXIF data
if [[ "$3" == "--strip" ]]; then
  strip_args="-strip"
fi

echo ""
echo "Resize to Size v2.0 by Robbie Ferguson"
echo ""
echo "This tool scales and compresses an image to a target filesize,"
echo "creating the best size/quality image possible within that limitation."
echo ""

if [[ $targetsize == '' ]] || [[ $file == '' ]]; then
  echo "Usage:   $0 SIZE_IN_MB FILENAME [--strip]"
  echo ""
  echo "Example: $0 2 sample.jpg"
  echo "Will scale and compress sample.jpg to 2 MB"
  echo ""
  echo "Add --strip to remove EXIF data for maximum compression"
  echo "(Warning: do not use --strip on equirectangular projections)"
  echo ""
  exit
fi

if [[ ! -e $file ]]; then
  echo "$file does not exist."
  echo ""
  exit
fi

# Auto-install ImageMagick if missing
if ! command -v convert &> /dev/null; then
  echo "ImageMagick is required but not installed."
  echo "Attempting to install..."
  echo ""
  if [ -f /etc/debian_version ]; then
    sudo apt-get update && sudo apt-get install -y imagemagick
  elif [ -f /etc/redhat-release ]; then
    sudo dnf install -y ImageMagick || sudo yum install -y ImageMagick
  else
    echo "Could not detect Debian or RHEL environment. Please install ImageMagick manually."
    exit 1
  fi
fi

save () {
  echo ""
  echo "File saved to $destfile"
  echo ""
}

targetsize=$(( $targetsize * 1000000 ))
extent_target=$(( targetsize - 10000 ))
destfile="${file%.*}_resized.jpg"
sourcesize=$(wc -c < "$file")

if (( $targetsize > $sourcesize )); then
  echo "$file is $(( $sourcesize / 1000000 )) MB. Not resizing to $(( $targetsize / 1000000 )) MB."
  echo ""
  exit
fi

# First attempt: try to decrease quality incrementally without re-scaling
printf "Attempting optimal compression..."
convert "$file" $strip_args -sampling-factor 4:2:0 -define jpeg:extent=${extent_target}b "$destfile"
filesize=$(wc -c < "$destfile")

if (( filesize <= targetsize && filesize > 0 )); then
  echo " Done."
  echo ""
  echo "Achieved target size using optimal compression."
  save
  exit
fi

# Second attempt: we'll slowly resize the image while testing high quality settings
printf " Failed."
echo ""
printf "Gradually reducing the scale of the image while adjusting compression..."
scale=95 # Starting percentage of scale
until [ $filesize -lt $targetsize ]
do
  convert "$file" -resize ${scale}% $strip_args -sampling-factor 4:2:0 -define jpeg:extent=${extent_target}b "$destfile"
  filesize=$(wc -c < "$destfile")
  
  if (( scale < 10 )); then
    echo " Failed."
    break
  fi
  scale=$(( $scale-5 ))
  printf "."
done

if (( $filesize < $targetsize && $filesize > 0 )); then
  # Adjust scale variable for output accuracy since the loop subtracts after successful conversion
  scale=$(( scale + 5 ))
  echo ""
  echo ""
  echo "Achieved target size by scaling the image to ${scale}% of its original size and setting optimal compression."
  save
  exit
fi

echo ""
echo "Sorry, I couldn't get your file down to that size."
echo ""
rm -f "$destfile"
